package menu

import "github.com/scttymn/vccmenu/app/shared/layout"
import "github.com/scttymn/vccmenu/assets"

templ editor(m Board) {
	@layout.Layout(layout.Page{Title: "Edit menu · Valley Coffee Co", Styles: assets.EditorStyles, Scripts: []string{"editor.js", "navigation.js"}, NoIndex: true}) {
		<main class="editor">
			@layout.Navigation("menu")
			<div class="intro"><p class="eyebrow">A LITTLE UPDATE, FRESHLY SERVED</p><h1>Make it yours.</h1><p>Change a price, set breakfast hours, or tuck an item away for later.</p></div>
			<div class="toolbar"><span id="summary">Loading your menu…</span></div>
			<form id="menu-form" hidden>
				<details class="settings">
					<summary>Shop name &amp; menu title</summary>
					<div class="settings-fields">
						<label>Shop name<input id="brand" maxlength="60" required/></label>
						<label>Menu title<input id="title" maxlength="30" required/></label>
						<label class="timezone">Timezone
							<select id="timezone">
								<option value="America/New_York">Eastern</option>
								<option value="America/Chicago">Central</option>
								<option value="America/Denver">Mountain</option>
								<option value="America/Phoenix">Arizona</option>
								<option value="America/Los_Angeles">Pacific</option>
								<option value="America/Anchorage">Alaska</option>
								<option value="Pacific/Honolulu">Hawaii</option>
							</select>
						</label>
					</div>
				</details>
				<div class="menu-bar">
					<div id="menu-list"></div>
					<div class="menu-actions">
						<button type="button" id="new-menu" class="secondary">New menu</button>
						<button type="button" id="copy-menu" class="secondary">Copy this menu</button>
					</div>
					<p class="menu-note">When two menus start together, the one higher in this list stays on the TV. A copy stays off the TV until you save.</p>
				</div>
				<label class="menu-name">Menu name<input id="menu-name" maxlength="40" required/></label>
				<div id="schedule" hidden></div>
				<p id="section-note" class="menu-note" hidden>These sections stay with this menu. The TV still shows the all-day menu on the left.</p>
				<div id="sections"></div>
				<div id="specials"></div>
				<div class="save-bar"><div><strong id="save-label">Everything is up to date</strong><p id="status" role="status" aria-live="polite">Changes reach the TV within 30 seconds of saving.</p></div><button id="save" type="submit" disabled>Save menu</button></div>
			</form>
			<p id="error" class="error" role="alert" hidden></p><button id="retry" class="secondary" type="button" hidden>Try loading again</button>
		</main>
		<template id="section-template"><details class="section-card"><summary><span class="section-number"></span><h2></h2><span class="item-count"></span><span class="chevron">⌄</span></summary><div class="section-content"><label class="section-name">Section name<input data-section="name" maxlength="30"/></label><div class="item-list"></div><button class="add secondary" type="button">+ Add an item</button><details class="section-settings"><summary>Notes &amp; toppings</summary><div class="settings-fields"><label>Note above the items<input data-section="note" maxlength="120"/></label><label>Note below the items<input data-section="footer" maxlength="120"/></label><label>Toppings or extras <span class="hint">One per line</span><textarea data-section="extras" rows="4"></textarea></label></div></details></div></details></template>
		<template id="item-template"><div class="item-editor"><div class="item-fields"><label>Item name<input data-field="name" maxlength="80" required/></label><label>Price <input data-field="price" maxlength="40" required placeholder="$4 / $4.50 / $5"/></label></div><div class="item-actions"><label class="visibility"><input type="checkbox" data-field="visible"/><span>On the menu</span></label><div class="row-buttons"><button type="button" class="move-up" aria-label="Move item up">↑</button><button type="button" class="move-down" aria-label="Move item down">↓</button><button type="button" class="remove">Remove</button></div></div></div></template>
		<template id="special-template"><div class="item-editor special-editor"><div class="item-fields"><label>Number<input data-special="number" type="number" min="1" max="99" inputmode="numeric" required/></label><label>Name<input data-special="name" maxlength="80" required/></label><label>What's included<input data-special="contents" maxlength="160" required/></label><label>Price<input data-special="price" maxlength="40" required placeholder="$6"/></label><label>Individual total<input data-special="individual" maxlength="40" placeholder="$8"/></label><label>Savings<input data-special="savings" maxlength="40" placeholder="Save $2"/></label></div><div class="item-actions"><button type="button" class="remove">Remove</button></div></div></template>
		<dialog id="menu-dialog">
			<form id="menu-dialog-form">
				<h2 id="dialog-title">New menu</h2>
				<label>Menu name<input id="dialog-name" maxlength="40" required/></label>
				<div id="dialog-when"></div>
				<p class="menu-note">The end time is not included, so breakfast can end at 10:30 and lunch can start at 10:30.</p>
				<div class="dialog-actions">
					<button type="button" id="dialog-cancel" class="secondary">Cancel</button>
					<button type="submit" id="dialog-confirm">Add menu</button>
				</div>
			</form>
		</dialog>
		@templ.JSONScript("initial-menu", m)
	}
}
