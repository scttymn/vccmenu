package menu

import "github.com/scttymn/vccmenu/app/shared/layout"
import "github.com/scttymn/vccmenu/assets"

templ display() {
	@layout.Layout(layout.Page{Title: "Valley Coffee Co Menu", Styles: assets.DisplayStyles, Scripts: []string{"display.js"}}) {
		<main id="screen" aria-label="Coffee shop menu"><div id="board"><header><p id="brand">Valley Coffee Co</p><h1 id="title">Menu</h1></header><div id="layout"><div id="columns"></div><aside id="rail" hidden></aside></div></div></main>
		<p id="loading" role="status">Loading menu…</p>
	}
}
