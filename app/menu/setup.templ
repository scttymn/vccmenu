package menu

import "github.com/scttymn/vccmenu/app/shared/layout"
import "github.com/scttymn/vccmenu/assets"

templ setup() {
	@layout.Layout(layout.Page{Title: "Set up your account · Valley Coffee Co", Styles: assets.EditorStyles, Scripts: []string{"setup.js"}, NoIndex: true}) {
		<main class="auth"><a href="/" class="wordmark">VALLEY COFFEE CO<span>MENU MANAGER</span></a><h1>Your menu, your way.</h1><p class="description">Use your one-time setup code to create an editor account.</p><p id="setup-error" class="auth-error" role="alert" hidden></p><form id="setup-form" action="/setup" method="post"><label>Setup code<input name="invitation" required autocomplete="off"/></label><label>Email<input type="email" name="email" required autocomplete="username"/></label><label>Password<input type="password" name="password" required minlength="8" maxlength="72" autocomplete="new-password"/></label><label>Confirm password<input type="password" name="confirmation" required minlength="8" maxlength="72" autocomplete="new-password"/></label><button>Create account</button></form></main>
	}
}
