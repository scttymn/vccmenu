package menu

import "github.com/scttymn/vccmenu/app/shared/layout"
import "github.com/scttymn/vccmenu/assets"

templ password() {
	@layout.Layout(layout.Page{Title: "Change password · Valley Coffee Co", Styles: assets.EditorStyles, Scripts: []string{"password.js", "navigation.js"}, NoIndex: true}) {
		<main class="editor">
			@layout.Navigation("password")
			<section class="auth password-panel"><h1>Make it your own.</h1><p class="description">Choose a new password with at least 8 characters. You’ll sign in again after saving.</p><p id="password-error" class="auth-error" role="alert" hidden></p><form id="password-form" action="/admin/password" method="post"><label>Current password<input type="password" name="current_password" required autocomplete="current-password"/></label><label>New password<input type="password" name="password" required minlength="8" maxlength="72" autocomplete="new-password"/></label><label>Confirm new password<input type="password" name="confirmation" required minlength="8" maxlength="72" autocomplete="new-password"/></label><button>Change password</button></form></section>
		</main>
	}
}
